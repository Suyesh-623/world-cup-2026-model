# ── Match-data feed (TheStatsAPI / API-Football / Sportmonks / ...) ──
# Fixtures, final scores, xG and stats for the rating model. Paste your key in
# your LOCAL model/.env (copy this file to model/.env), NEVER here, NEVER in chat.
STATS_API_KEY=
STATS_API_BASE=https://api.thestatsapi.com/api    # set to your provider's base URL

# Kalshi API — live market odds (Phase 1.1).
# Create a key at https://kalshi.com/account/profile -> API Keys -> Create New API Key.
# The private key is shown ONCE; save it to the path below. Never commit it.
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi_private_key.pem
KALSHI_ENV=demo                 # demo | prod

# Bankroll + risk policy
BANKROLL=10000
KELLY_FRACTION=0.5              # half-Kelly: the disciplined default
MAX_KELLY_FRACTION=0.10         # hard per-bet cap as a fraction of bankroll
MIN_EDGE=0.02                   # ignore edges below 2 percentage points
CONTRACT_FEE=0.01              # Robinhood per-contract fee, charged each side

# Alerts (Phase 1.1) — email when a +EV bet crosses the threshold
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=
